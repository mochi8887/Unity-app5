  m_text: "\u304A\u60A9\u307F\u805E\u3044\u3066\u6B32\u3057\u3044\u30AD\u30EA\u30F3\u3001\u3001\n\n\u5B9F\u306F\u6700\u8FD1\u5168\u7136\u4ED5\u4E8B\u304C\u3067\u304D\u306A\u304F\u3066\u56F0\u3063\u3066\u308B\u30AD\u30EA\u30F3\u3001\u3001\n\u540C\u671F\u306E\u307F\u3093\u306A\u306F\u6B21\u3005\u306B\u51FA\u4E16\u3057\u3066\u3044\u304F\u306E\u306B\u50D5\u3060\u3051\u7F6E\u3044\u3066\u3051\u307C\u308A\u30AD\u30EA\u30F3\u3002\n\n\u50D5\u306E\u4F1A\u793E\u3067\u306F\u51FA\u4E16\u3067\u304D\u308B\u4EBA\u6570\u304C\u9650\u3089\u308C\u3066\u3044\u308B\u30AD\u30EA\u30F3\u3002\n\u51FA\u4E16\u3059\u308B\u305F\u3081\u306B\u306F\u4ED6\u4EBA\u306E\u8DB3\u3092\u5F15\u3063\u5F35\u3063\u305F\u308A\u81EA\u5206\u304C\u5982\u4F55\u306B\u6709\u80FD\u306A\u4EBA\u9593\u304B\u62AB\u9732\u3057\u3066\u51FA\u4E16\u3059\u308B\u4EBA\u304C\u307B\u3068\u3093\u3069\u3060\u30AD\u30EA\u30F3\u3002\u3002\n\n\u3053\u308C\u306F\u5909\u3048\u3089\u308C\u306A\u3044\u4E8B\u5B9F\u3060\u304B\u3089\u3001\u50D5\u306E\u5FC3\u306B\u5BC4\u308A\u6DFB\u3063\u3066\u304F\u308C\u308B\u97F3\u697D\u3092\u6559\u3048\u3066\u304F\u308C\u30AD\u30EA\u30F3\u3002"
